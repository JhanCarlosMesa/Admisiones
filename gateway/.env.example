# ------------------------------------------------------------------
# Gateway institucional de credenciales verificables UNAC
# Copia este archivo a .env y ajusta los valores.
# ------------------------------------------------------------------

# Puerto donde escucha el gateway.
PORT=3080

# "file" = los anclajes se guardan en un archivo JSONL encadenado (sin infra).
# "network" = delega la escritura en un relay externo (Fabric, Polygon Edge…).
RELAY=file
RELAY_URL=

# Llave de firma institucional. Se genera con: npm run keys
SIGNING_KEY_PATH=./keys/unac-signing-key.pem

# Archivo con los anclajes (cadena encadenada).
CHAIN_FILE=./data/anchors.jsonl

# Clave para cifrar en reposo los documentos off-chain. Vacía = sin cifrar.
DOCUMENT_KEY=

# Token compartido para las operaciones de escritura (emitir y revocar).
#
# ATENCIÓN: es un compromiso de proyecto de clase. Este valor viaja en el
# bundle del navegador, así que cualquiera que abra las herramientas de
# desarrollo puede leerlo. En producción debe sustituirse por OAuth 2.0 con
# PKCE contra el IdP institucional.
STAFF_TOKEN=cambia-este-token

# Orígenes permitidos para el navegador del portal (separados por coma).
ALLOWED_ORIGINS=http://localhost:5173
